// Project: rawk (Rust AWK)
// Authors: Francesco Tinti & Antigravity (Google Deepmind)
// Description: A high-fidelity port of the historic AWK language from C to Rust.

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ "#" ~ (!"\n" ~ ANY)* }

program = { SOI ~ (function_decl | rule)* ~ EOI }

rule = { 
    (pattern ~ action_block) |
    pattern |
    action_block
}

action_block = { "{" ~ statement* ~ "}" }

function_decl = { "function" ~ ident ~ "(" ~ ident_list? ~ ")" ~ action_block }
ident_list = { ident ~ ("," ~ ident)* }

pattern = { "BEGINFILE" | "ENDFILE" | "BEGIN" | "END" | regex_pattern | expr }
regex_pattern = ${ "/" ~ regex_inner ~ "/" }
regex_inner = @{ (!"/" ~ ANY)* }

statement = {
    (if_stmt |
    while_stmt |
    do_while_stmt |
    for_in_stmt |
    for_stmt |
    print_stmt |
    printf_stmt |
    delete_stmt |
    break_stmt |
    continue_stmt |
    next_stmt |
    return_stmt |
    exit_stmt |
    assign_stmt |
    expr_stmt) ~ ";"?
}

if_stmt = { "if" ~ "(" ~ expr ~ ")" ~ block_or_stmt ~ ("else" ~ block_or_stmt)? }
while_stmt = { "while" ~ "(" ~ expr ~ ")" ~ block_or_stmt }
do_while_stmt = { "do" ~ block_or_stmt ~ "while" ~ "(" ~ expr ~ ")" }
for_in_stmt = { "for" ~ "(" ~ ident ~ "in" ~ ident ~ ")" ~ block_or_stmt }
for_stmt = { "for" ~ "(" ~ for_init? ~ ";" ~ for_cond? ~ ";" ~ for_step? ~ ")" ~ block_or_stmt }
for_init = { assign_stmt | expr }
for_cond = { expr }
for_step = { assign_stmt | expr }
delete_stmt = { "delete" ~ ident ~ ("[" ~ expr_list ~ "]")? }
print_stmt = { "print" ~ expr_list? ~ redirect? }
printf_stmt = { "printf" ~ expr_list? ~ redirect? }
break_stmt = { "break" }
continue_stmt = { "continue" }
next_stmt = { "next" }
return_stmt = { "return" ~ expr? }
exit_stmt = { "exit" ~ expr? }
redirect = { (">>" | ">" | "|") ~ expr }
assign_stmt = { assignable ~ assign_op ~ expr }
assign_op = { "=" | "+=" | "-=" | "*=" | "/=" }
expr_stmt = { expr }

block_or_stmt = { action_block | statement }

assignable = { array_access | field | ident }

expr_list = { expr ~ ("," ~ expr)* }

expr = { logical_expr ~ ("?" ~ expr ~ ":" ~ expr)? }
logical_expr = { term ~ (infix_op ~ term)* }
term = { prefix_op? ~ primary ~ postfix_op? }

primary = { getline_expr | field | func_call | array_access | number | string_literal | regex_pattern | ident | "(" ~ expr ~ ")" }

getline_expr = { "getline" ~ ident? ~ ("<" ~ expr)? }
field = { "$" ~ primary }
array_access = { ident ~ "[" ~ expr_list ~ "]" }
func_call = { ident ~ "(" ~ expr_list? ~ ")" }

prefix_op = _{ op_inc | op_dec | op_not | op_plus | op_minus }
postfix_op = _{ op_inc | op_dec }

infix_op = _{ op_and | op_or | op_match | op_not_match | op_in | op_eq | op_neq | op_ge | op_le | op_gt | op_lt | op_add | op_sub | op_mul | op_div }

op_and = { "&&" }
op_or  = { "||" }
op_match = { "~" }
op_not_match = { "!~" }
op_in  = { "in" }
op_eq  = { "==" }
op_neq = { "!=" }
op_ge  = { ">=" }
op_le  = { "<=" }
op_gt  = { ">" }
op_lt  = { "<" }
op_add = { "+" }
op_sub = { "-" }
op_mul = { "*" }
op_div = { "/" }

op_not = { "!" }
op_plus = { "+" }
op_minus = { "-" }
op_inc = { "++" }
op_dec = { "--" }

ident = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
number = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT*)? }
string_literal = ${ "\"" ~ inner_string ~ "\"" }
inner_string = @{ (!"\"" ~ ANY)* }
