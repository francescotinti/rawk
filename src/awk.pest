// Project: rawk (Rust AWK)
// Authors: Francesco Tinti & Antigravity (Google Deepmind)
// Description: A high-fidelity port of the historic AWK language from C to Rust.

WHITESPACE = _{ " " | "\t" | "\r" }
COMMENT = _{ "#" ~ (!"\n" ~ ANY)* }
nl = _{ "\n" }
eos = _{ ";" | nl }

program = { SOI ~ nl* ~ ( (function_decl | rule) ~ nl* )* ~ EOI }

rule = { 
    (pattern ~ nl* ~ action_block) |
    pattern |
    action_block
}

action_block = { "{" ~ nl* ~ (statement ~ nl*)* ~ "}" }

function_decl = { "function" ~ ident ~ "(" ~ nl* ~ ident_list? ~ nl* ~ ")" ~ nl* ~ action_block }
ident_list = { ident ~ (nl* ~ "," ~ nl* ~ ident)* }

pattern = { "BEGINFILE" | "ENDFILE" | "BEGIN" | "END" | regex_pattern | expr }
regex_pattern = ${ "/" ~ regex_inner ~ "/" }
regex_inner = @{ (!"/" ~ ANY)* }

statement = {
    (if_stmt |
    while_stmt |
    do_while_stmt |
    for_in_stmt |
    for_stmt |
    printf_stmt |
    print_stmt |
    delete_stmt |
    break_stmt |
    continue_stmt |
    nextfile_stmt |
    next_stmt |
    return_stmt |
    exit_stmt |
    assign_stmt |
    expr_stmt) ~ eos?
}

if_stmt = { "if" ~ nl* ~ "(" ~ nl* ~ expr ~ nl* ~ ")" ~ nl* ~ block_or_stmt ~ (nl* ~ "else" ~ nl* ~ block_or_stmt)? }
while_stmt = { "while" ~ nl* ~ "(" ~ nl* ~ expr ~ nl* ~ ")" ~ nl* ~ block_or_stmt }
do_while_stmt = { "do" ~ nl* ~ block_or_stmt ~ nl* ~ "while" ~ nl* ~ "(" ~ nl* ~ expr ~ nl* ~ ")" }
for_in_stmt = { "for" ~ nl* ~ "(" ~ nl* ~ ident ~ nl* ~ "in" ~ nl* ~ ident ~ nl* ~ ")" ~ nl* ~ block_or_stmt }
for_stmt = { "for" ~ nl* ~ "(" ~ nl* ~ for_init? ~ nl* ~ ";" ~ nl* ~ for_cond? ~ nl* ~ ";" ~ nl* ~ for_step? ~ nl* ~ ")" ~ nl* ~ block_or_stmt }
for_init = { assign_stmt | expr }
for_cond = { expr }
for_step = { assign_stmt | expr }
delete_stmt = { "delete" ~ ident ~ ("[" ~ nl* ~ expr_list ~ nl* ~ "]")? }
print_stmt = { "print" ~ print_expr_list? ~ redirect? }
printf_stmt = { "printf" ~ print_expr_list? ~ redirect? }
break_stmt = { "break" }
continue_stmt = { "continue" }
nextfile_stmt = { "nextfile" }
next_stmt = { "next" }
return_stmt = { "return" ~ expr? }
exit_stmt = { "exit" ~ expr? }
redirect = { (">>" | ">" | "|") ~ expr }
assign_stmt = { assignable ~ assign_op ~ nl* ~ expr }
assign_op = { "+=" | "-=" | "*=" | "/=" | "=" }
expr_stmt = { expr }

block_or_stmt = { action_block | statement }

assignable = { array_access | field | ident }

expr_list = { expr ~ (nl* ~ "," ~ nl* ~ expr)* }

expr           = { ternary_expr }
ternary_expr   = { logical_or ~ (nl* ~ "?" ~ nl* ~ expr ~ nl* ~ ":" ~ nl* ~ expr)? }
logical_or     = { logical_and ~ (nl* ~ op_or ~ nl* ~ logical_and)* }
logical_and    = { in_expr ~ (nl* ~ op_and ~ nl* ~ in_expr)* }
in_expr        = { match_expr ~ (nl* ~ op_in ~ nl* ~ ident)? }
match_expr     = { rel_expr ~ (nl* ~ (op_match | op_not_match) ~ nl* ~ rel_expr)* }
rel_expr       = { concat_expr ~ (nl* ~ rel_op ~ nl* ~ concat_expr)* }
rel_op         = _{ op_eq | op_neq | op_ge | op_le | op_gt | op_lt }

print_expr_list = { print_expr ~ (nl* ~ "," ~ nl* ~ print_expr)* }
print_expr = { print_ternary_expr }
print_ternary_expr = { print_logical_or ~ (nl* ~ "?" ~ nl* ~ print_expr ~ nl* ~ ":" ~ nl* ~ print_expr)? }
print_logical_or = { print_logical_and ~ (nl* ~ op_or ~ nl* ~ print_logical_and)* }
print_logical_and = { print_in_expr ~ (nl* ~ op_and ~ nl* ~ print_in_expr)* }
print_in_expr = { print_match_expr ~ (nl* ~ op_in ~ nl* ~ ident)? }
print_match_expr = { print_rel_expr ~ (nl* ~ (op_match | op_not_match) ~ nl* ~ print_rel_expr)* }
print_rel_expr = { concat_expr ~ (nl* ~ print_rel_op ~ nl* ~ concat_expr)* }
print_rel_op = _{ op_eq | op_neq | op_le | op_lt }
concat_expr    = { add_expr ~ add_expr* }
add_expr       = { mul_expr ~ (nl* ~ (op_add | op_sub) ~ nl* ~ mul_expr)* }
mul_expr       = { pow_expr ~ (nl* ~ (op_mul | op_div | op_mod) ~ nl* ~ pow_expr)* }
pow_expr       = { term ~ (nl* ~ op_pow ~ nl* ~ pow_expr)? }
term           = { (prefix_op ~ nl*)? ~ primary ~ (nl* ~ postfix_op)? }

non_getline_primary = { field | func_call | array_access | number | string_literal | regex_pattern | ident | ("(" ~ nl* ~ expr ~ nl* ~ ")") }
primary = { getline_expr | non_getline_primary }

getline_expr = { pipe_getline | plain_getline }
pipe_getline = { non_getline_primary ~ nl* ~ "|" ~ nl* ~ "getline" ~ ident? }
plain_getline = { "getline" ~ ident? ~ (nl* ~ "<" ~ nl* ~ expr)? }
field = { "$" ~ primary }
array_access = { ident ~ "[" ~ nl* ~ expr_list ~ nl* ~ "]" }
func_name = @{ ident ~ "(" }
func_call = { func_name ~ nl* ~ expr_list? ~ nl* ~ ")" }
ws_or_nl  = _{ " " | "\t" | "\r" | "\n" }

prefix_op = _{ op_inc | op_dec | op_not | op_plus | op_minus }
postfix_op = _{ op_inc | op_dec }

op_and = { "&&" }
op_or  = { "||" }
op_match = { "~" }
op_not_match = { "!~" }
op_in  = { "in" }
op_eq  = { "==" }
op_neq = { "!=" }
op_ge  = { ">=" }
op_le  = { "<=" }
op_gt  = { ">" }
op_lt  = { "<" }
op_add = { "+" }
op_sub = { "-" }
op_mul = { "*" }
op_div = { "/" }
op_mod = { "%" }
op_pow = { "**" | "^" }

op_not = { "!" }
op_plus = { "+" }
op_minus = { "-" }
op_inc = { "++" }
op_dec = { "--" }

ident = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
number = @{ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT*)? ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? }
string_literal = ${ "\"" ~ inner_string ~ "\"" }
inner_string = @{ (!"\"" ~ ANY)* }
