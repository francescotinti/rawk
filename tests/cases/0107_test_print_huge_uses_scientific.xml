<?xml version='1.0' encoding='UTF-8'?>
<testcase name="test_print_huge_uses_scientific">
    <awk>BEGIN { print 1e21 }</awk>
    <expected_stdout match="exact">1e+21
</expected_stdout>
    <expected_divergence reason="bwk-different-number-format">
        <stdout>1000000000000000000000
</stdout>
        <stderr />
        <status>0</status>
    </expected_divergence>
</testcase>