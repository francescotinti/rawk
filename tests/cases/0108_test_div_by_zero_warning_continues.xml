<?xml version='1.0' encoding='UTF-8'?>
<testcase name="test_div_by_zero_is_fatal">
    <awk>BEGIN { x = 5/0; print "after:" x }</awk>
    <expected_stderr>rawk: division by zero
</expected_stderr>
    <expected_stdout match="exact" />
    <expected_divergence reason="diagnostic-format">
        <stdout />
        <stderr>&lt;AWK&gt;: division by zero
 source line number 1
</stderr>
        <status>2</status>
    </expected_divergence>
    <expected_status>2</expected_status>
</testcase>