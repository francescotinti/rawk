<?xml version='1.0' encoding='UTF-8'?>
<testcase name="test_record_terminator_rt">
    <awk>
        BEGIN { RS="A" }
        { print $0, "RT:", RT }
        </awk>
    <stdin>1A2A3</stdin>
    <expected_stdout match="exact">1 RT: A
2 RT: A
3 RT:&#32;
</expected_stdout>
    <expected_divergence reason="bwk-missing-gawk-extension">
        <stdout>1 RT:&#32;
2 RT:&#32;
3 RT:&#32;
</stdout>
        <stderr />
        <status>0</status>
    </expected_divergence>
</testcase>