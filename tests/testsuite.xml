<?xml version="1.0" encoding="UTF-8"?>
<testsuite name="Rawk Integration Tests">
    <!-- Basic functionality -->
    <testcase name="test_basic_print">
        <awk><![CDATA[{ print $1, $2 }]]></awk>
        <stdin><![CDATA[hello world
foo bar]]></stdin>
        <expected_stdout match="exact"><![CDATA[hello world
foo bar
]]></expected_stdout>
    </testcase>
    <testcase name="test_record_separator">
        <awk><![CDATA[BEGIN { RS = "|" } { print $1 }]]></awk>
        <stdin><![CDATA[A|B|C]]></stdin>
        <expected_stdout match="exact"><![CDATA[A
B
C
]]></expected_stdout>
    </testcase>
    <testcase name="test_type_coercion">
        <awk><![CDATA[BEGIN { print "10" + 5, "42" == 42, "abc" + 0 }]]></awk>
        <expected_stdout match="exact"><![CDATA[15 1 0
]]></expected_stdout>
    </testcase>
    <testcase name="test_control_flow">
        <awk><![CDATA[BEGIN { sum = 0; i = 1; while(i<=5) { sum = sum + i; i = i + 1 }; print sum }]]></awk>
        <expected_stdout match="exact"><![CDATA[15
]]></expected_stdout>
    </testcase>

    <!-- Expressions and Built-ins -->
    <testcase name="test_math_functions">
        <awk><![CDATA[BEGIN { print sqrt(16), int(3.9) }]]></awk>
        <expected_stdout match="exact"><![CDATA[4 3
]]></expected_stdout>
    </testcase>
    <testcase name="test_bitwise_and_time">
        <awk><![CDATA[BEGIN { print and(5, 3), lshift(1, 2) }]]></awk>
        <expected_stdout match="exact"><![CDATA[1 4
]]></expected_stdout>
    </testcase>
    <testcase name="test_string_manipulation">
        <awk><![CDATA[BEGIN { s = "foo bar"; gsub("bar", "baz", s); print s, length(s), toupper(s) }]]></awk>
        <expected_stdout match="exact"><![CDATA[foo baz 7 FOO BAZ
]]></expected_stdout>
    </testcase>
    <testcase name="test_arrays_and_delete">
        <awk><![CDATA[BEGIN { a["key"] = 42; print a["key"]; delete a["key"]; print a["key"] }]]></awk>
        <expected_stdout match="exact"><![CDATA[42

]]></expected_stdout>
    </testcase>
    <testcase name="test_user_functions">
        <awk><![CDATA[
        function add(x, y) { return x + y } 
        BEGIN { print add(5, 7) }
        ]]></awk>
        <expected_stdout match="exact"><![CDATA[12
]]></expected_stdout>
    </testcase>
    <testcase name="test_regex_matching">
        <awk><![CDATA[
        $1 ~ /^[0-9]+$/ { print "number:", $1 }
        $1 !~ /^[0-9]+$/ { print "string:", $1 }
        ]]></awk>
        <stdin><![CDATA[123
abc
456
def]]></stdin>
        <expected_stdout match="exact"><![CDATA[number: 123
string: abc
number: 456
string: def
]]></expected_stdout>
    </testcase>

    <!-- GNU AWK Manual Tests -->
    <testcase name="test_gawk_manual_longest_line">
        <awk><![CDATA[{ if (length($0) > max) max = length($0) } END { print max }]]></awk>
        <stdin><![CDATA[short
this is a much longer line
tiny]]></stdin>
        <expected_stdout match="exact"><![CDATA[26
]]></expected_stdout>
    </testcase>
    <testcase name="test_gawk_manual_seven_random_numbers">
        <awk><![CDATA[BEGIN { srand(1); for (i = 1; i <= 7; i++) print int(101 * rand()) }]]></awk>
        <expected_stdout match="exact"><![CDATA[98
69
43
17
25
97
39
]]></expected_stdout>
    </testcase>
    <testcase name="test_gawk_manual_two_rules">
        <awk><![CDATA[
        /12/ { print $0 } 
        /21/ { print $0 }
        ]]></awk>
        <stdin><![CDATA[foo 12 bar
baz 21 qux
no match]]></stdin>
        <expected_stdout match="exact"><![CDATA[foo 12 bar
baz 21 qux
]]></expected_stdout>
    </testcase>
    <testcase name="test_gawk_manual_ch8_arrays">
        <awk><![CDATA[{ arr[$1] = $0 } END { print arr["1"] }]]></awk>
        <stdin><![CDATA[2 two
1 one
3 three]]></stdin>
        <expected_stdout match="exact"><![CDATA[1 one
]]></expected_stdout>
    </testcase>
    <testcase name="test_gawk_manual_ch9_functions">
        <awk><![CDATA[
        function my_max(a, b) { 
            if (a > b) return a; 
            else return b 
        } 
        BEGIN { print my_max(10, 20) }
        ]]></awk>
        <expected_stdout match="exact"><![CDATA[20
]]></expected_stdout>
    </testcase>
    <testcase name="test_gawk_manual_part2_deduplication">
        <awk><![CDATA[
        {
            if (data[$0]++ == 0)
                lines[++count] = $0
        }
        END {
            for (i = 1; i <= count; i++)
                print lines[i]
        }
        ]]></awk>
        <stdin><![CDATA[foo
bar
foo
baz
bar]]></stdin>
        <expected_stdout match="exact"><![CDATA[foo
bar
baz
]]></expected_stdout>
    </testcase>
    <testcase name="test_gawk_manual_word_frequency">
        <awk><![CDATA[{
        $0 = tolower($0)
        gsub(/[^a-z0-9_ \t]/, "", $0)
        for (i = 1; i <= NF; i++)
            freq[$i]++
    }
    END {
        for (word in freq)
            print word, freq[word]
    }]]></awk>
        <stdin><![CDATA[Hello world! Hello, AWK.]]></stdin>
        <expected_stdout match="contains"><![CDATA[world 1
awk 1
hello 2
]]></expected_stdout>
    </testcase>
    <testcase name="test_csv_parsing">
        <awk><![CDATA[
        BEGIN { FS="," }
        NR > 1 {
            sum += $3
            print $2, "is", $3, "years old"
        }
        END {
            print "Average age:", sum / (NR - 1)
        }
        ]]></awk>
        <stdin><![CDATA[id,name,age,city
1,Alice,30,New York
2,Bob,25,Los Angeles
3,Charlie,35,Chicago]]></stdin>
        <expected_stdout match="exact"><![CDATA[Alice is 30 years old
Bob is 25 years old
Charlie is 35 years old
Average age: 30
]]></expected_stdout>
    </testcase>
    <!-- Medium Article Examples -->
    <testcase name="test_medium_print_fields">
        <awk><![CDATA[ { print $1, $3 } ]]></awk>
        <stdin><![CDATA[John Doe 30 180
Jane Smith 25 165
Alice Johnson 28 170
Bob Brown 35 175
Charlie White 32 182]]></stdin>
        <expected_stdout match="exact"><![CDATA[John 30
Jane 25
Alice 28
Bob 35
Charlie 32
]]></expected_stdout>
    </testcase>
    <testcase name="test_medium_delimiter">
        <awk><![CDATA[ BEGIN { OFS=";" } { print $1, $3 } ]]></awk>
        <stdin><![CDATA[John Doe 30 180
Jane Smith 25 165
Alice Johnson 28 170
Bob Brown 35 175
Charlie White 32 182]]></stdin>
        <expected_stdout match="exact"><![CDATA[John;30
Jane;25
Alice;28
Bob;35
Charlie;32
]]></expected_stdout>
    </testcase>
    <testcase name="test_medium_filter_height">
        <awk><![CDATA[ $4 > 169 ]]></awk>
        <stdin><![CDATA[John Doe 30 180
Jane Smith 25 165
Alice Johnson 28 170
Bob Brown 35 175
Charlie White 32 182]]></stdin>
        <expected_stdout match="exact"><![CDATA[John Doe 30 180
Alice Johnson 28 170
Bob Brown 35 175
Charlie White 32 182
]]></expected_stdout>
    </testcase>
    <testcase name="test_medium_search_pattern">
        <awk><![CDATA[ /John/ ]]></awk>
        <stdin><![CDATA[John Doe 30 180
Jane Smith 25 165
Alice Johnson 28 170
Bob Brown 35 175
Charlie White 32 182]]></stdin>
        <expected_stdout match="exact"><![CDATA[John Doe 30 180
Alice Johnson 28 170
]]></expected_stdout>
    </testcase>
    <testcase name="test_medium_math">
        <awk><![CDATA[ { print $3 + $4 } ]]></awk>
        <stdin><![CDATA[John Doe 30 180
Jane Smith 25 165
Alice Johnson 28 170
Bob Brown 35 175
Charlie White 32 182]]></stdin>
        <expected_stdout match="exact"><![CDATA[210
190
198
210
214
]]></expected_stdout>
    </testcase>
    <testcase name="test_medium_sum_avg">
        <awk><![CDATA[ 
        { sum += $4 }
        END { print sum, sum/NR } 
        ]]></awk>
        <stdin><![CDATA[John Doe 30 180
Jane Smith 25 165
Alice Johnson 28 170
Bob Brown 35 175
Charlie White 32 182]]></stdin>
        <expected_stdout match="exact"><![CDATA[872 174.4
]]></expected_stdout>
    </testcase>
    <testcase name="test_medium_nf_last">
        <awk><![CDATA[ { print "Fields:", NF, "| Last:", $NF } ]]></awk>
        <stdin><![CDATA[John Doe 30 180
Jane Smith 25 165
Alice Johnson 28 170
Bob Brown 35 175
Charlie White 32 182]]></stdin>
        <expected_stdout match="exact"><![CDATA[Fields: 4 | Last: 180
Fields: 4 | Last: 165
Fields: 4 | Last: 170
Fields: 4 | Last: 175
Fields: 4 | Last: 182
]]></expected_stdout>
    </testcase>
    <testcase name="test_medium_string_functions">
        <awk><![CDATA[ { print toupper($1), substr($2,1,3), length($2) } ]]></awk>
        <stdin><![CDATA[John Doe 30 180
Jane Smith 25 165
Alice Johnson 28 170
Bob Brown 35 175
Charlie White 32 182]]></stdin>
        <expected_stdout match="exact"><![CDATA[JOHN Doe 3
JANE Smi 5
ALICE Joh 7
BOB Bro 5
CHARLIE Whi 5
]]></expected_stdout>
    </testcase>
    <testcase name="test_gawk_manual_wc">
        <awk><![CDATA[ 
        {
            chars += length($0) + 1  
            words += NF
        }
        END { print NR, words, chars }
        ]]></awk>
        <stdin><![CDATA[hello world
this is a test]]></stdin>
        <expected_stdout match="exact"><![CDATA[2 6 27
]]></expected_stdout>
    </testcase>
    <testcase name="test_gawk_manual_gsub_replacement">
        <awk><![CDATA[ 
        BEGIN {
            pat = "apple"
            repl = "orange"
        }
        { gsub(pat, repl); print $0 }
        ]]></awk>
        <stdin><![CDATA[I like apple.
apple pie is good.]]></stdin>
        <expected_stdout match="exact"><![CDATA[I like orange.
orange pie is good.
]]></expected_stdout>
    </testcase>
    <!-- Advanced GNU AWK features -->
    <testcase name="test_record_terminator_rt">
        <awk><![CDATA[ 
        BEGIN { RS="A" } 
        { print $0, "RT:", RT }
        ]]></awk>
        <stdin><![CDATA[1A2A3]]></stdin>
        <expected_stdout match="exact"><![CDATA[1 RT: A
2 RT: A
3 RT: 
]]></expected_stdout>
    </testcase>
    <testcase name="test_pow_and_mod_and_unary">
        <awk><![CDATA[ 
        BEGIN {
            print -1.5e-3
            print -(2+3)
            print +5
            print 2**10
            print 17 % 5
            print 2^0.5
        }
        ]]></awk>
        <stdin><![CDATA[]]></stdin>
        <expected_stdout match="exact"><![CDATA[-0.0015
-5
5
1024
2
1.41421
]]></expected_stdout>
    </testcase>
    <testcase name="test_strnum_truthy">
        <awk><![CDATA[ 
        { if ($1) print "T"; else print "F" }
        ]]></awk>
        <stdin><![CDATA[0
1
abc
]]></stdin>
        <expected_stdout match="exact"><![CDATA[F
T
T
]]></expected_stdout>
    </testcase>
    <testcase name="test_concat_basic">
        <awk><![CDATA[BEGIN { print "a" "b" "c" }]]></awk>
        <expected_stdout match="exact"><![CDATA[abc
]]></expected_stdout>
    </testcase>
    <testcase name="test_concat_field">
        <awk><![CDATA[{ print $1 $2 "-" $3 }]]></awk>
        <stdin><![CDATA[foo bar baz]]></stdin>
        <expected_stdout match="exact"><![CDATA[foobar-baz
]]></expected_stdout>
    </testcase>
    <testcase name="test_concat_paren">
        <awk><![CDATA[BEGIN { print "a" ("b" "c") "d" }]]></awk>
        <expected_stdout match="exact"><![CDATA[abcd
]]></expected_stdout>
    </testcase>
    <testcase name="test_concat_unary_precedence">
        <awk><![CDATA[BEGIN { print -1 "x" }]]></awk>
        <expected_stdout match="exact"><![CDATA[-1x
]]></expected_stdout>
    </testcase>
    <testcase name="test_concat_arith_precedence">
        <awk><![CDATA[BEGIN { print 1 + 2 "x" 3 + 4 }]]></awk>
        <expected_stdout match="exact"><![CDATA[3x7
]]></expected_stdout>
    </testcase>
    <testcase name="test_concat_func_call_disambig">
        <awk><![CDATA[
        function add(x) { return x + 1 }
        BEGIN { print add(5), add (5) }
        ]]></awk>
        <expected_stdout match="exact"><![CDATA[6 5
]]></expected_stdout>
    </testcase>
    <testcase name="test_concat_var_with_paren_expr">
        <awk><![CDATA[BEGIN { x = "hello"; print x (1 + 2) }]]></awk>
        <expected_stdout match="exact"><![CDATA[hello3
]]></expected_stdout>
    </testcase>
    <testcase name="test_concat_with_relational">
        <awk><![CDATA[BEGIN { if ("ab" "c" == "abc") print "ok" }]]></awk>
        <expected_stdout match="exact"><![CDATA[ok
]]></expected_stdout>
    </testcase>
    <testcase name="test_convfmt_default_float">
        <awk><![CDATA[BEGIN { x = 0.1 + 0.2; print "x=" x }]]></awk>
        <expected_stdout match="exact"><![CDATA[x=0.3
]]></expected_stdout>
    </testcase>
    <testcase name="test_convfmt_integer_no_decimal">
        <awk><![CDATA[BEGIN { print "n=" 42 ", m=" 3.0 }]]></awk>
        <expected_stdout match="exact"><![CDATA[n=42, m=3
]]></expected_stdout>
