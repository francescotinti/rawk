    <testcase name="test_convfmt_custom">
        <awk><![CDATA[BEGIN { CONVFMT="%.2f"; x = 1/3; print "x=" x }]]></awk>
        <expected_stdout match="exact"><![CDATA[x=0.33
]]></expected_stdout>
